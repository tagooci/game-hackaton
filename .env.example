# Server reads exported environment variables; this file is NOT loaded automatically.
# Never put server configuration in VITE_* variables: those are public client data.
GAME_DB_PATH=db/game.sqlite3
# Set only after creating the trusted account. Empty disables administrator access.
GAME_ADMIN_PLAYER_ID=
# HTTPS deployment only:
GAME_COOKIE_SECURE=true
# Replace with the exact browser origin(s), comma separated.
GAME_ALLOWED_ORIGINS=https://game.example.invalid
